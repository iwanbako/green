---
/**
 * Kota: Jakarta Pusat
 * Mode: SSR Only — Unique Content + Product Slider + Contact Form
 */

import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CityHero from '@/components/city/CityHero.astro';
import {
  MapPin,
  Truck,
  Clock,
  Factory,
  ChefHat,
  ShieldCheck,
  Store,
  Building2,
  CheckCircle2,
  Leaf,
  Send,
  CalendarClock,
  Landmark,
  Hotel,
} from 'lucide-react';
import { jabodetabekCities } from '@/data/cities';

const city = {
  slug: 'jakarta-pusat',
  name: 'Jakarta Pusat',
  title: 'Supplier Sayur Jakarta Pusat | Pemasok Kantin & Perkantoran',
  angle:
    'Penyedia kebutuhan sayur mayur terlengkap untuk kantin gedung dan hotel di jantung ibu kota Jakarta.',
  seoContent:
    'Di pusat bisnis Sudirman-Thamrin, ketepatan waktu adalah prioritas. Kami menggunakan armada yang paham akses loading bay gedung tinggi di Jakarta Pusat untuk menjamin suplai tiba sebelum jam sarapan.',
  clientFocus: 'Kantin Gedung, Hotel CBD, & Kedutaan Besar',
  deliveryRoute:
    'Strategi logistik fajar menjangkau area Menteng, Gambir, dan Tanah Abang.',
  usp: 'Harga tangan pertama langsung dari petani dengan administrasi PKP lengkap.',
  logistics: [
    {
      time: '20:30',
      title: 'Mainstock Packing',
      desc: 'Persiapan stok komoditas utama standar retail.',
    },
    {
      time: '01:00',
      title: 'Central Core Route',
      desc: 'Pengiriman area jantung kota menembus jalur ganjil-genap.',
    },
    {
      time: '05:00',
      title: 'Urban Kitchen Drop',
      desc: 'Diterima oleh pengelola kantin/steward hotel.',
    },
  ],
};

const title = `Supplier Sayur ${city.name} untuk Kantin Gedung, Hotel CBD & Kedutaan | CV Green Fresh Cipanas`;
const description = `Distributor sayuran segar di ${city.name} dengan pengiriman subuh tembus ganjil-genap, harga grosir, dan legalitas PKP. Termin pembayaran 7 hari untuk klien baru. Melayani ${city.clientFocus} di seluruh area ${city.name}.`;

const waNumber = '6287780937884';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: `Supplier Sayur Segar ${city.name}`,
      provider: {
        '@type': 'LocalBusiness',
        name: 'CV Green Fresh Cipanas',
      },
      areaServed: {
        '@type': 'City',
        name: city.name,
      },
      description: description,
    },
  ],
};

const currentIndex = jabodetabekCities.findIndex((c) => c.slug === city.slug);
const otherCities = [];
for (let i = 1; i <= 6; i++) {
  const nextIndex = (currentIndex + i) % jabodetabekCities.length;
  otherCities.push(jabodetabekCities[nextIndex]);
}

// Zona Jakarta Pusat — 8 kecamatan + koridor CBD
const jakpusZones = [
  { name: 'Menteng', note: 'Kedutaan besar & hotel butik premium' },
  { name: 'Gambir', note: 'Stasiun & perkantoran pemerintah' },
  { name: 'Tanah Abang', note: 'Pasar grosir & kantor korporat' },
  { name: 'Sawah Besar', note: 'Kantor & UMKM kuliner' },
  { name: 'Kemayoran', note: 'Gedung pemerintahan & hotel' },
  { name: 'Cempaka Putih', note: 'Kantin perkantoran & rumah sakit' },
  { name: 'Johar Baru', note: 'Warung makan & UMKM kuliner' },
  { name: 'Senen', note: 'Pasar & kantin stasiun' },
  { name: 'Koridor Sudirman', note: 'CBD gedung tinggi & hotel bintang 5' },
  { name: 'Koridor Thamrin', note: 'CBD, hotel, & restoran fine dining' },
  { name: 'Kuningan (perbatasan)', note: 'CBD gedung & embassy row' },
  { name: 'Setiabudi (perbatasan)', note: 'Gedung perkantoran & resto premium' },
];

// Kawasan karakteristik Jakarta Pusat
const jakpusIndustri = [
  {
    name: 'Koridor Sudirman-Thamrin',
    note: 'CBD dengan gedung tinggi & hotel bintang 5 butuh sayur grade A untuk buffet & fine dining',
  },
  {
    name: 'Menteng & Kedutaan',
    note: 'Kedutaan besar & resto fine dining butuh sayur premium dengan standar plating internasional',
  },
  {
    name: 'Kemayoran & Gambir',
    note: 'Gedung pemerintahan & hotel butuh supply harian untuk kantin karyawan & meeting room',
  },
  {
    name: 'Tanah Abang',
    note: 'Pasar grosir & kantor korporat butuh volume besar dengan harga tangan pertama',
  },
  {
    name: 'Cempaka Putih & Johar Baru',
    note: 'Kantin perkantoran & UMKM kuliner butuh sayur fresh harian dengan minimum order ramah',
  },
  {
    name: 'Loading Bay Access',
    note: 'Armada kami paham akses loading bay gedung tinggi & aturan ganjil-genap CBD Jakarta Pusat',
  },
];

// Tipe klien Jakarta Pusat
const jakpusClientTypes = [
  {
    icon: Building2,
    title: 'Kantin Gedung Perkantoran',
    desc: 'Kantin gedung di Sudirman-Thamrin butuh pasokan harian untuk ribuan karyawan dengan jadwal pengiriman yang ketat.',
  },
  {
    icon: Hotel,
    title: 'Hotel CBD & Bintang 5',
    desc: 'Hotel di koridor Sudirman-Thamrin butuh sayur grade A untuk buffet breakfast & fine dining plating.',
  },
  {
    icon: Landmark,
    title: 'Kedutaan & Instansi Pemerintah',
    desc: 'Kedutaan di Menteng & instansi pemerintah butuh supplier dengan administrasi PKP lengkap dan standar kualitas internasional.',
  },
  {
    icon: ChefHat,
    title: 'Restoran Fine Dining',
    desc: 'Resto fine dining di Menteng & Thamrin butuh sayur premium dengan grading konsisten untuk plating menu.',
  },
];

const jakpusLegal = [
  'Faktur pajak elektronik resmi (PKP) untuk kebutuhan audit internal.',
  'Termin pembayaran 7 hari (Net 7) untuk klien baru.',
  'Term of Payment (TOP) hingga 30 hari untuk klien kontrak rutin.',
  'Surat jalan dan berita acara penerimaan untuk setiap pengiriman.',
  'Kontrak suplai tahunan dengan harga yang di-lock per kuartal.',
];

// Sayur unggulan — sesuai kebutuhan hotel CBD & fine dining
const vegetables = [
  {
    name: 'Selada Romaine',
    desc: 'Daun utuh, crispy. Favorit buffet breakfast hotel bintang 5.',
    img: 'https://images.unsplash.com/photo-1622206151226-18ca2c9ab4a1?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Brokoli Hijau',
    desc: 'Grade A, kuntum rapat. Untuk buffet hotel & plating fine dining.',
    img: 'https://images.unsplash.com/photo-1459411621453-7b03977f4bfc?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Paprika Merah',
    desc: 'Tebal, manis. Untuk plating resto premium & menu kontinental.',
    img: 'https://images.unsplash.com/photo-1563565375-f3fdfdbefa83?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Tomat Cherry',
    desc: 'Manis alami, warna cerah. Favorit salad bar hotel & resto fine dining.',
    img: 'https://images.unsplash.com/photo-1592924357228-91a4daadcfea?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Wortel Brastagi',
    desc: 'Manis alami, warna oranye cerah. Cocok sup & tumis kantin gedung.',
    img: 'https://images.unsplash.com/photo-1598170845058-32b9d6a5da37?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Bayam Hijau',
    desc: 'Daun lebar, batang muda. Ideal untuk menu kantin & katering.',
    img: 'https://images.unsplash.com/photo-1576045057995-568f588f82fb?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Sawi Hijau',
    desc: 'Daun utuh, segar. Untuk tumis & capcay kantin gedung.',
    img: 'https://images.unsplash.com/photo-1576045057995-568f588f82fb?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Bok Choy',
    desc: 'Batang putih, daun hijau. Wajib untuk chinese food resto premium.',
    img: 'https://images.unsplash.com/photo-1594282486552-05b4d80fbb9f?w=600&q=80&auto=format&fit=crop',
  },
];
---

<MainLayout title={title} description={description}>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <div class="bg-white text-[#052c17] font-sans antialiased overflow-x-hidden">
    <Header />
    <CityHero city={city} />

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8 sm:space-y-10">

      <!-- ============ SECTION 1: INTRO ============ -->
      <section>
        <span class="inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest text-[#166534] bg-green-50 border border-green-200 px-2.5 py-1 rounded-full mb-3">
          <MapPin size={10} /> {city.name}, DKI Jakarta
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-[#052c17] tracking-tight leading-tight mb-4">
          Supplier Sayur {city.name} untuk Kantin Gedung, Hotel CBD & Kedutaan
        </h2>
        <div class="space-y-3 text-slate-700 leading-relaxed">
          <p>
            {city.angle} CV Green Fresh Cipanas paham karakter Jakarta Pusat
            yang sangat khas: kantin gedung di Sudirman-Thamrin butuh sayur
            segar sebelum jam 5 pagi untuk menu sarapan karyawan, sementara
            hotel bintang 5 di koridor Thamrin butuh sayur grade A untuk
            buffet breakfast & fine dining plating. {city.deliveryRoute} {city.seoContent}
          </p>
          <p>
            Kami fokus pada satu hal yang paling sering dilupakan supplier
            besar: <strong>akses loading bay gedung tinggi & jalur ganjil-genap</strong>.
            Bukan sekadar "bisa kirim", tapi bisa kirim ke CBD Jakarta Pusat
            tanpa hambatan regulasi. {city.usp}
          </p>
        </div>
      </section>

      <!-- ============ SECTION 2: SLIDER PRODUK ============ -->
      <section>
        <div class="flex items-end justify-between gap-3 mb-4">
          <div class="min-w-0">
            <h3 class="text-lg sm:text-xl font-bold text-[#052c17] flex items-center gap-2">
              <Leaf size={18} class="text-[#166534]" /> Sayuran Segar untuk Hotel & Kantin
            </h3>
            <p class="text-sm text-slate-600 mt-1">
              Dipanen pagi, dikirim subuh, sampai loading bay sebelum jam 5.
            </p>
          </div>
          <div class="hidden sm:flex items-center gap-2 shrink-0">
            <button
              type="button"
              data-slider-prev
              aria-label="Sebelumnya"
              class="w-9 h-9 rounded-full border border-slate-300 bg-white hover:bg-green-50 hover:border-[#166534] active:scale-95 transition flex items-center justify-center text-[#052c17]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button
              type="button"
              data-slider-next
              aria-label="Berikutnya"
              class="w-9 h-9 rounded-full border border-slate-300 bg-white hover:bg-green-50 hover:border-[#166534] active:scale-95 transition flex items-center justify-center text-[#052c17]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>

        <div
          id="veggie-slider"
          class="flex overflow-x-auto snap-x snap-mandatory gap-3 pb-2 scrollbar-hide scroll-smooth"
        >
          {vegetables.map((v) => (
            <article class="snap-start shrink-0 w-[240px] sm:w-[260px] rounded-xl overflow-hidden border border-slate-200 bg-white hover:shadow-md hover:border-[#166534]/30 transition">
              <div class="relative h-40 sm:h-44 bg-slate-100">
                <img
                  src={v.img}
                  alt={v.name}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
                <span class="absolute top-2 left-2 text-[9px] font-black uppercase tracking-wider bg-white/95 text-[#166534] border border-green-200 px-2 py-0.5 rounded">
                  Fresh
                </span>
              </div>
              <div class="p-3">
                <h4 class="font-bold text-sm text-[#052c17] mb-0.5">
                  {v.name}
                </h4>
                <p class="text-[11px] text-slate-600 leading-snug">
                  {v.desc}
                </p>
              </div>
            </article>
          ))}
        </div>

        <p class="text-[10px] text-slate-400 mt-2 text-center sm:hidden">
          ← geser untuk lihat lainnya →
        </p>
      </section>

      <!-- ============ SECTION 3: TIPE KLIEN ============ -->
      <section>
        <div class="mb-4">
          <h3 class="text-lg sm:text-xl font-bold text-[#052c17]">
            Tipe Klien di {city.name}
          </h3>
          <p class="text-sm text-slate-600 mt-1">
            {city.clientFocus} — masing-masing punya pola order, jadwal, dan
            jenis sayur favorit berbeda.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {jakpusClientTypes.map((c) => (
            <div class="flex items-start gap-3 p-4 rounded-xl border border-slate-200 border-l-4 border-l-[#166534] bg-white hover:bg-green-50/40 hover:shadow-sm transition">
              <div class="w-9 h-9 rounded-lg bg-[#166534] text-white flex items-center justify-center shrink-0">
                <c.icon size={16} />
              </div>
              <div class="min-w-0">
                <h4 class="font-bold text-sm text-[#052c17] mb-1">
                  {c.title}
                </h4>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {c.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ SECTION 4: KAWASAN + TIMELINE (2 kolom) ============ -->
      <section class="grid md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-lg sm:text-xl font-bold text-[#052c17] mb-3 flex items-center gap-2">
            <Factory size={18} class="text-[#166534]" /> Kawasan Kuliner Jakarta Pusat
          </h3>
          <p class="text-sm text-slate-600 mb-3">
            Jakarta Pusat punya karakter unik: CBD, kedutaan, dan pemerintahan.
            Kami sudah terbiasa melayani:
          </p>
          <ul class="space-y-2">
            {jakpusIndustri.map((z) => (
              <li class="flex items-start gap-2.5 p-3 rounded-lg bg-slate-50 border border-slate-100">
                <span class="w-1.5 h-1.5 rounded-full bg-[#166534] mt-2 shrink-0"></span>
                <div>
                  <strong class="text-sm text-[#052c17]">{z.name}</strong>
                  <p class="text-xs text-slate-600 leading-snug mt-0.5">
                    {z.note}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-lg sm:text-xl font-bold text-[#052c17] mb-3 flex items-center gap-2">
            <Clock size={18} class="text-[#166534]" /> Timeline Distribusi Subuh
          </h3>
          <p class="text-sm text-slate-600 mb-3">
            Loading bay hotel & kantin gedung tutup jam 6. Kami kirim sebelum
            itu, tembus ganjil-genap. Berikut jadwal operasional kami:
          </p>
          <div class="space-y-2">
            {city.logistics.map((l) => (
              <div class="flex items-start gap-3 p-3 rounded-lg bg-white border border-slate-200">
                <div class="shrink-0 text-center">
                  <span class="inline-block text-xs font-mono font-bold text-[#166534] bg-green-50 border border-green-200 rounded px-2 py-0.5">
                    {l.time}
                  </span>
                </div>
                <div>
                  <strong class="text-sm text-[#052c17]">{l.title}</strong>
                  <p class="text-xs text-slate-600 leading-snug mt-0.5">
                    {l.desc}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ SECTION 5: LEGALITAS ============ -->
      <section>
        <h3 class="text-lg sm:text-xl font-bold text-[#052c17] mb-3 flex items-center gap-2">
          <ShieldCheck size={18} class="text-[#166534]" /> Legalitas & Administrasi Perusahaan
        </h3>
        <div class="grid sm:grid-cols-2 gap-2.5">
          {jakpusLegal.map((item) => (
            <div class="flex items-start gap-2.5 p-3 rounded-lg bg-green-50/60 border border-green-100">
              <CheckCircle2 size={14} class="text-[#166534] mt-0.5 shrink-0" />
              <span class="text-sm text-slate-700 leading-snug">{item}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ SECTION 6: ZONA KECAMATAN ============ -->
      <section>
        <div class="mb-3">
          <h3 class="text-lg sm:text-xl font-bold text-[#052c17] flex items-center gap-2">
            <MapPin size={18} class="text-[#166534]" /> Zona Pengiriman — Jakarta Pusat & Sekitarnya
          </h3>
          <p class="text-sm text-slate-600 mt-1">
            Jadwal dan minimum order disesuaikan dengan karakter tiap zona.
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
          {jakpusZones.map((z) => (
            <div class="p-3 rounded-lg border border-slate-200 bg-white hover:border-[#166534] hover:bg-green-50/40 transition">
              <div class="font-bold text-xs text-[#052c17] mb-0.5">
                {z.name}
              </div>
              <div class="text-[11px] text-slate-600 leading-snug">
                {z.note}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ SECTION 7: AREA SEKITAR ============ -->
      <section>
        <div class="mb-3">
          <h3 class="text-lg sm:text-xl font-bold text-[#052c17] flex items-center gap-2">
            <Truck size={18} class="text-[#166534]" /> Area Sekitar {city.name}
          </h3>
          <p class="text-sm text-slate-600 mt-1">
            Kami juga melayani kota-kota berikut dengan pola pengiriman yang
            sama.
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
          {otherCities.map((otherCity) => (
            <a
              href={`/kota/${otherCity.slug}`}
              class="group p-3 rounded-lg border border-slate-200 bg-white hover:border-[#166534] hover:bg-green-50 transition text-center"
            >
              <span class="text-xs font-bold uppercase tracking-wide text-[#052c17] group-hover:text-[#166534]">
                {otherCity.name}
              </span>
            </a>
          ))}
        </div>
      </section>

      <!-- ============ SECTION 8: CONTACT FORM + TERMIN 7 HARI ============ -->
      <section id="kontak" class="scroll-mt-20">
        <div class="rounded-2xl border-2 border-[#166534] bg-gradient-to-br from-[#f0fdf4] to-white overflow-hidden">

          <!-- Header form -->
          <div class="p-5 sm:p-6 border-b-2 border-[#166534]/20 bg-[#166534]">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-white/15 backdrop-blur flex items-center justify-center shrink-0">
                <Send size={18} class="text-white" />
              </div>
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-white">
                  Minta Penawaran Suplai {city.name}
                </h3>
                <p class="text-xs sm:text-sm text-green-100 mt-0.5">
                  Isi form — tim kami balas via WhatsApp dalam 1×24 jam kerja.
                </p>
              </div>
            </div>

            <!-- Badge Termin 7 Hari -->
            <div class="mt-4 inline-flex items-center gap-2 bg-yellow-300 text-[#052c17] border border-yellow-400 rounded-lg px-3 py-1.5">
              <CalendarClock size={14} />
              <span class="text-xs font-bold">
                Termin Pembayaran 7 Hari untuk Klien Baru
              </span>
            </div>
          </div>

          <!-- Form body -->
          <form
            id="kontak-form"
            class="p-5 sm:p-6 space-y-4"
            data-wa={waNumber}
            data-kota={city.name}
            novalidate
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="nama" class="block text-xs font-bold text-[#052c17] mb-1">
                  Nama Lengkap <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="nama"
                  name="nama"
                  required
                  autocomplete="name"
                  placeholder="Budi Santoso"
                  class="w-full px-3 py-2.5 text-sm rounded-lg border border-slate-300 bg-white focus:border-[#166534] focus:ring-2 focus:ring-[#166534]/20 outline-none transition"
                />
              </div>

              <div>
                <label for="usaha" class="block text-xs font-bold text-[#052c17] mb-1">
                  Nama Usaha / Perusahaan <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="usaha"
                  name="usaha"
                  required
                  autocomplete="organization"
                  placeholder="PT Kantin Sejahtera"
                  class="w-full px-3 py-2.5 text-sm rounded-lg border border-slate-300 bg-white focus:border-[#166534] focus:ring-2 focus:ring-[#166534]/20 outline-none transition"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="whatsapp" class="block text-xs font-bold text-[#052c17] mb-1">
                  No. WhatsApp <span class="text-rose-500">*</span>
                </label>
                <input
                  type="tel"
                  id="whatsapp"
                  name="whatsapp"
                  required
                  inputmode="numeric"
                  pattern="[0-9+\s-]{8,18}"
                  autocomplete="tel"
                  placeholder="08xx xxxx xxxx"
                  class="w-full px-3 py-2.5 text-sm rounded-lg border border-slate-300 bg-white focus:border-[#166534] focus:ring-2 focus:ring-[#166534]/20 outline-none transition"
                />
              </div>

              <div>
                <label for="zona" class="block text-xs font-bold text-[#052c17] mb-1">
                  Zona Pengiriman <span class="text-rose-500">*</span>
                </label>
                <select
                  id="zona"
                  name="zona"
                  required
                  class="w-full px-3 py-2.5 text-sm rounded-lg border border-slate-300 bg-white focus:border-[#166534] focus:ring-2 focus:ring-[#166534]/20 outline-none transition"
                >
                  <option value="">— Pilih zona —</option>
                  {jakpusZones.map((z) => (
                    <option value={z.name}>{z.name}</option>
                  ))}
                </select>
              </div>
            </div>

            <div>
              <label for="kebutuhan" class="block text-xs font-bold text-[#052c17] mb-1">
                Kebutuhan Sayur <span class="text-rose-500">*</span>
              </label>
              <textarea
                id="kebutuhan"
                name="kebutuhan"
                required
                rows="3"
                placeholder="Contoh: Selada Romaine 20 kg/hari, Brokoli 15 kg/hari untuk buffet breakfast hotel bintang 5."
                class="w-full px-3 py-2.5 text-sm rounded-lg border border-slate-300 bg-white focus:border-[#166534] focus:ring-2 focus:ring-[#166534]/20 outline-none transition resize-y"
              ></textarea>
            </div>

            <div>
              <label for="volume" class="block text-xs font-bold text-[#052c17] mb-1">
                Estimasi Volume Harian <span class="text-slate-400 font-normal">(opsional)</span>
              </label>
              <input
                type="text"
                id="volume"
                name="volume"
                placeholder="Contoh: ±80 kg per hari"
                class="w-full px-3 py-2.5 text-sm rounded-lg border border-slate-300 bg-white focus:border-[#166534] focus:ring-2 focus:ring-[#166534]/20 outline-none transition"
              />
            </div>

            <!-- Checkbox termin 7 hari -->
            <div class="p-3 rounded-lg bg-yellow-50 border border-yellow-200">
              <label class="flex items-start gap-2.5 cursor-pointer">
                <input
                  type="checkbox"
                  id="termin7"
                  name="termin7"
                  required
                  class="mt-0.5 w-4 h-4 rounded border-slate-300 text-[#166534] focus:ring-[#166534]"
                />
                <span class="text-xs text-slate-700 leading-relaxed">
                  Saya setuju dengan skema <strong>termin pembayaran 7 hari (Net 7)</strong> untuk transaksi pertama, dengan syarat & ketentuan yang berlaku.
                </span>
              </label>
            </div>

            <!-- Error message -->
            <div
              id="form-error"
              class="hidden p-3 rounded-lg bg-rose-50 border border-rose-200 text-xs text-rose-700"
              role="alert"
            ></div>

            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#166534] text-white font-bold text-sm hover:bg-[#14532d] active:scale-[0.98] transition shadow-md"
            >
              <Send size={16} /> Kirim via WhatsApp
            </button>

            <p class="text-[10px] text-slate-500 leading-relaxed">
              Dengan mengirim form ini, Anda akan diarahkan ke WhatsApp kami
              dengan pesan yang sudah terisi otomatis. Tim marketing akan
              membalas dalam 1×24 jam kerja.
            </p>
          </form>
        </div>
      </section>

      <!-- ============ CTA PENUTUP ============ -->
      <section class="p-5 sm:p-6 rounded-2xl bg-gradient-to-br from-[#f0fdf4] to-[#dcfce7] border-2 border-green-200">
        <p class="text-sm sm:text-base text-slate-700 leading-relaxed italic">
          Untuk kantin gedung, hotel CBD, dan kedutaan di Jakarta Pusat,
          memilih supplier bukan soal harga termurah — tapi soal siapa yang
          bisa hadir konsisten setiap subuh melewati jalur ganjil-genap dan
          akses loading bay gedung tinggi, 365 hari setahun. Kalau Anda
          mengelola kantin gedung, hotel, resto fine dining, atau instansi
          pemerintah di Jakarta Pusat, isi form di atas atau hubungi tim
          pemasaran kami untuk diskusi skema suplai yang paling efisien.
        </p>
      </section>

    </main>

    <Footer />
  </div>
</MainLayout>

<script is:inline>
  (function () {
    // ---- Slider ----
    const slider = document.getElementById('veggie-slider');
    if (slider) {
      const scrollAmount = 280;
      document.querySelectorAll('[data-slider-prev]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });
      });
      document.querySelectorAll('[data-slider-next]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
      });
    }

    // ---- Contact Form -> WhatsApp ----
    const form = document.getElementById('kontak-form');
    if (!form) return;

    const waNumber = form.getAttribute('data-wa') || '6287780937884';
    const kota = form.getAttribute('data-kota') || 'Jakarta Pusat';
    const errorBox = document.getElementById('form-error');

    function showError(msg) {
      if (!errorBox) return;
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
    }

    function hideError() {
      if (!errorBox) return;
      errorBox.classList.add('hidden');
      errorBox.textContent = '';
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      hideError();

      const nama = form.querySelector('#nama').value.trim();
      const usaha = form.querySelector('#usaha').value.trim();
      const whatsapp = form.querySelector('#whatsapp').value.trim();
      const zona = form.querySelector('#zona').value;
      const kebutuhan = form.querySelector('#kebutuhan').value.trim();
      const volume = form.querySelector('#volume').value.trim();
      const termin7 = form.querySelector('#termin7').checked;

      if (!nama || !usaha || !whatsapp || !zona || !kebutuhan) {
        showError('Mohon lengkapi semua field bertanda * sebelum mengirim.');
        return;
      }

      if (!termin7) {
        showError('Centang persetujuan termin 7 hari untuk melanjutkan.');
        return;
      }

      const lines = [
        '*PENAWARAN SUPLAI SAYUR - ' + kota.toUpperCase() + '*',
        '',
        'Nama: ' + nama,
        'Usaha: ' + usaha,
        'WhatsApp: ' + whatsapp,
        'Zona: ' + zona,
        'Kebutuhan: ' + kebutuhan,
      ];
      if (volume) lines.push('Volume: ' + volume);
      lines.push('');
      lines.push('Skema pembayaran: Termin 7 hari (disetujui)');
      lines.push('');
      lines.push('Mohon info harga dan ketersediaan stok.');

      const text = encodeURIComponent(lines.join('\n'));
      const url = 'https://wa.me/' + waNumber + '?text=' + text;

      window.open(url, '_blank', 'noopener,noreferrer');
    });
  })();
</script>

