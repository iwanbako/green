---
/**
 * Kota: Jakarta Selatan
 * Mode: SSR Only — Unique Content + Product Slider + Contact Form
 */

import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CityHero from '@/components/city/CityHero.astro';
import {
  MapPin,
  Truck,
  Clock,
  Factory,
  ChefHat,
  ShieldCheck,
  Store,
  Building2,
  CheckCircle2,
  Leaf,
  Send,
  CalendarClock,
  Hotel,
  Sparkles,
} from 'lucide-react';
import { jabodetabekCities } from '@/data/cities';

const city = {
  slug: 'jakarta-selatan',
  name: 'Jakarta Selatan',
  title: 'Supplier Sayuran Jakarta Selatan | Partner Fine Dining & Hotel',
  angle:
    'Menyediakan pengadaan sayur Grade-A untuk restoran fine dining dan hotel. Presisi pada ukuran, warna, dan kesegaran.',
  seoContent:
    'Melayani kawasan Senopati, SCBD, hingga Kemang. Kami memahami standar tinggi Jakarta Selatan yang menuntut visual sayuran sempurna (Grade AAA) untuk kebutuhan menu premium dan eksklusif.',
  clientFocus: 'Fine Dining, Hotel Bintang 5, & Luxury Cafe',
  deliveryRoute:
    'Sistem rute subuh Jakarta Selatan memastikan kesegaran produk tanpa hambatan macet.',
  usp: 'Rantai pasok terintegrasi: Panen - Sortasi - Kirim langsung ke Jakarta Selatan.',
  logistics: [
    {
      time: '21:30',
      title: 'Manual Sortation',
      desc: 'Sortasi manual (tangan) untuk standar visual terbaik.',
    },
    {
      time: '02:00',
      title: 'South Metro Fleet',
      desc: 'Distribusi merata ke area pusat bisnis Jakarta Selatan.',
    },
    {
      time: '05:30',
      title: 'Kitchen Prep Drop',
      desc: 'Tiba tepat waktu untuk persiapan prapengolahan koki pagi.',
    },
  ],
};

const title = `Supplier Sayur ${city.name} untuk Fine Dining, Hotel Bintang 5 & Luxury Cafe | CV Green Fresh Cipanas`;
const description = `Distributor sayuran Grade A di ${city.name} dengan sortasi manual, pengiriman subuh via rute bebas macet, dan legalitas PKP. Termin pembayaran 7 hari untuk klien baru. Melayani ${city.clientFocus} di seluruh area ${city.name}.`;

const waNumber = '6287780937884';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: `Supplier Sayur Segar ${city.name}`,
      provider: {
        '@type': 'LocalBusiness',
        name: 'CV Green Fresh Cipanas',
      },
      areaServed: {
        '@type': 'City',
        name: city.name,
      },
      description: description,
    },
  ],
};

const currentIndex = jabodetabekCities.findIndex((c) => c.slug === city.slug);
const otherCities = [];
for (let i = 1; i <= 6; i++) {
  const nextIndex = (currentIndex + i) % jabodetabekCities.length;
  otherCities.push(jabodetabekCities[nextIndex]);
}

// Zona Jakarta Selatan — 10 kecamatan + koridor premium
const jakselZones = [
  { name: 'Kebayoran Baru', note: 'SCBD, Senopati, & resto fine dining premium' },
  { name: 'Setiabudi', note: 'Kuningan CBD & hotel bintang 5' },
  { name: 'Mampang Prapatan', note: 'Resto premium & kantor korporat' },
  { name: 'Cilandak', note: 'Pondok Indah & resto keluarga premium' },
  { name: 'Kebayoran Lama', note: 'Resto & cafe koridor premium' },
  { name: 'Pesanggrahan', note: 'Cafe modern & resto suburban' },
  { name: 'Tebet', note: 'Resto keluarga & kafe trendi' },
  { name: 'Pasar Minggu', note: 'Resto premium & kantor pemerintahan' },
  { name: 'Pancoran', note: 'Kafe instagramable & resto modern' },
  { name: 'Jagakarsa', note: 'Katering & resto lokal premium' },
  { name: 'Koridor SCBD', note: 'Fine dining & hotel bintang 5' },
  { name: 'Koridor Kemang', note: 'Resto ekspat & luxury cafe' },
];

// Kawasan karakteristik Jakarta Selatan
const jakselIndustri = [
  {
    name: 'SCBD (Sudirman Central Business District)',
    note: 'Fine dining & hotel bintang 5 butuh sayur Grade AAA untuk plating premium',
  },
  {
    name: 'Senopati & Gunawarman',
    note: 'Resto fine dining & luxury cafe butuh sayur visual sempurna untuk menu eksklusif',
  },
  {
    name: 'Kemang',
    note: 'Restoran ekspat & kafe internasional butuh sayur dengan standar plating Eropa',
  },
  {
    name: 'Pondok Indah',
    note: 'Resto keluarga premium & hotel butuh sayur grade A dengan grading konsisten',
  },
  {
    name: 'Kuningan & Setiabudi',
    note: 'CBD & hotel butuh supply harian untuk buffet & meeting room premium',
  },
  {
    name: 'Tebet & Mampang',
    note: 'Resto & kafe trendi butuh sayur fresh untuk menu modern & plating instagramable',
  },
];

// Tipe klien Jakarta Selatan
const jakselClientTypes = [
  {
    icon: Sparkles,
    title: 'Fine Dining & Michelin-Ready',
    desc: 'Resto fine dining di SCBD & Senopati butuh sayur grade AAA dengan presisi visual: ukuran seragam, warna sempurna, tanpa cacat.',
  },
  {
    icon: Hotel,
    title: 'Hotel Bintang 5',
    desc: 'Hotel bintang 5 di Kuningan & SCBD butuh sayur grade A untuk buffet breakfast & plating fine dining dengan standar internasional.',
  },
  {
    icon: ChefHat,
    title: 'Luxury Cafe & Resto Premium',
    desc: 'Luxury cafe di Kemang & Senopati butuh microgreens, edible flowers, dan sayur premium untuk menu fusion & plating artistik.',
  },
  {
    icon: Store,
    title: 'Resto Keluarga Premium',
    desc: 'Resto keluarga premium di Pondok Indah & Tebet butuh sayur grade A konsisten untuk menu harian & weekend brunch.',
  },
];

const jakselLegal = [
  'Faktur pajak elektronik resmi (PKP) untuk kebutuhan audit internal.',
  'Termin pembayaran 7 hari (Net 7) untuk klien baru.',
  'Term of Payment (TOP) hingga 30 hari untuk klien kontrak rutin.',
  'Sertifikat sortasi manual (hand-picked) untuk setiap pengiriman premium.',
  'Kontrak suplai tahunan dengan harga yang di-lock per kuartal.',
];

// Sayur premium — disesuaikan untuk fine dining & plating
const vegetables = [
  {
    name: 'Microgreens Mix',
    desc: 'Arugula, radish, & beet microgreens. Untuk garnish & plating fine dining.',
    img: 'https://images.unsplash.com/photo-1622206151226-18ca2c9ab4a1?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Baby Romaine',
    desc: 'Daun kecil, crispy. Favorit Caesar salad resto premium & hotel bintang 5.',
    img: 'https://images.unsplash.com/photo-1622206151226-18ca2c9ab4a1?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Asparagus Hijau',
    desc: 'Tunas muda, renyah. Untuk plating steak & menu kontinental premium.',
    img: 'https://images.unsplash.com/photo-1515471209610-8ed038f9747e?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Zucchini Muda',
    desc: 'Kulit cerah, daging lembut. Untuk grill, ratatouille & pasta premium.',
    img: 'https://images.unsplash.com/photo-1563565375-f3fdfdbefa83?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Paprika Merah',
    desc: 'Tebal, manis. Untuk plating resto premium & menu kontinental.',
    img: 'https://images.unsplash.com/photo-1563565375-f3fdfdbefa83?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Tomat Cherry',
    desc: 'Manis alami, warna cerah. Favorit salad bar hotel & resto fine dining.',
    img: 'https://images.unsplash.com/photo-1592924357228-91a4daadcfea?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Brokoli Hijau',
    desc: 'Grade A, kuntum rapat. Untuk plating resto premium & buffet hotel.',
    img: 'https://images.unsplash.com/photo-1459411621453-7b03977f4bfc?w=600&q=80&auto=format&fit=crop',
  },
  {
    name: 'Edible Flowers',
    desc: 'Bunga edible food-grade. Untuk garnish plating fine dining & dessert premium.',
    img: 'https://images.unsplash.com/photo-1490750967868-88aa4486c946?w=600&q=80&auto=format&fit=crop',
  },
];
---

<MainLayout title={title} description={description}>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <div class="bg-white text-[#052c17] font-sans antialiased overflow-x-hidden">
    <Header />
    <CityHero city={city} />

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8 sm:space-y-10">

      <!-- ============ SECTION 1: INTRO ============ -->
      <section>
        <span class="inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest text-[#166534] bg-green-50 border border-green-200 px-2.5 py-1 rounded-full mb-3">
          <MapPin size={10} /> {city.name}, DKI Jakarta
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-[#052c17] tracking-tight leading-tight mb-4">
          Supplier Sayur {city.name} untuk Fine Dining, Hotel Bintang 5 & Luxury Cafe
        </h2>
        <div class="space-y-3 text-slate-700 leading-relaxed">
          <p>
            {city.angle} CV Green Fresh Cipanas paham standar Jakarta Selatan
            yang paling ketat di Indonesia: resto fine dining di SCBD dan
            Senopati butuh sayur grade AAA dengan presisi visual untuk
            plating, sementara hotel bintang 5 di Kuningan butuh sayur
            konsisten untuk buffet breakfast & fine dining. {city.deliveryRoute} {city.seoContent}
          </p>
          <p>
            Kami fokus pada satu hal yang paling sering dilupakan supplier
            besar: <strong>sortasi manual untuk standar visual premium</strong>.
            Bukan sekadar "bisa kirim grade A", tapi bisa kirim sayur dengan
            ukuran seragam, warna sempurna, dan tanpa cacat — persis seperti
            yang dibutuhkan plating fine dining. {city.usp}
          </p>
        </div>
      </section>

      <!-- ============ SECTION 2: SLIDER PRODUK ============ -->
      <section>
        <div class="flex items-end justify-between gap-3 mb-4">
          <div class="min-w-0">
            <h3 class="text-lg sm:text-xl font-bold text-[#052c17] flex items-center gap-2">
              <Leaf size={18} class="text-[#166534]" /> Sayuran Premium untuk Plating & Buffet
            </h3>
            <p class="text-sm text-slate-600 mt-1">
              Dipanen pagi, disortasi manual, sampai dapur Anda sebelum jam 5:30.
            </p>
          </div>
          <div class="hidden sm:flex items-center gap-2 shrink-0">
            <button
              type="button"
              data-slider-prev
              aria-label="Sebelumnya"
              class="w-9 h-9 rounded-full border border-slate-300 bg-white hover:bg-green-50 hover:border-[#166534] active:scale-95 transition flex items-center justify-center text-[#052c17]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button
              type="button"
              data-slider-next
              aria-label="Berikutnya"
              class="w-9 h-9 rounded-full border border-slate-300 bg-white hover:bg-green-50 hover:border-[#166534] active:scale-95 transition flex items-center justify-center text-[#052c17]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>

        <div
          id="veggie-slider"
          class="flex overflow-x-auto snap-x snap-mandatory gap-3 pb-2 scrollbar-hide scroll-smooth"
        >
          {vegetables.map((v) => (
            <article class="snap-start shrink-0 w-[240px] sm:w-[260px] rounded-xl overflow-hidden border border-slate-200 bg-white hover:shadow-md hover:border-[#166534]/30 transition">
              <div class="relative h-40 sm:h-44 bg-slate-100">
                <img
                  src={v.img}
                  alt={v.name}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
                <span class="absolute top-2 left-2 text-[9px] font-black uppercase tracking-wider bg-white/95 text-[#166534] border border-green-200 px-2 py-0.5 rounded">
                  Grade A
                </span>
              </div>
              <div class="p-3">
                <h4 class="font-bold text-sm text-[#052c17] mb-0.5">
                  {v.name}
                </h4>
                <p class="text-[11px] text-slate-600 leading-snug">
                  {v.desc}
                </p>
              </div>
            </article>
          ))}
        </div>

        <p class="text-[10px] text-slate-400 mt-2 text-center sm:hidden">
          ← geser untuk lihat lainnya →
        </p>
      </section>

      <!-- ============ SECTION 3: TIPE KLIEN ============ -->
      <section>
        <div class="mb-4">
          <h3 class="text-lg sm:text-xl font-bold text-[#052c17]">
            Tipe Klien di {city.name}
          </h3>
          <p class="text-sm text-slate-600 mt-1">
            {city.clientFocus} — masing-masing punya pola order, jadwal, dan
            jenis sayur favorit berbeda.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {jakselClientTypes.map((c) => (
            <div class="flex items-start gap-3 p-4 rounded-xl border border-slate-200 border-l-4 border-l-[#166534] bg-white hover:bg-green-50/40 hover:shadow-sm transition">
              <div class="w-9 h-9 rounded-lg bg-[#166534] text-white flex items-center justify-center shrink-0">
                <c.icon size={16} />
              </div>
              <div class="min-w-0">
                <h4 class="font-bold text-sm text-[#052c17] mb-1">
                  {c.title}
                </h4>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {c.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ SECTION 4: KAWASAN + TIMELINE (2 kolom) ============ -->
      <section class="grid md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-lg sm:text-xl font-bold text-[#052c17] mb-3 flex items-center gap-2">
            <Factory size={18} class="text-[#166534]" /> Kawasan Premium Jakarta Selatan
          </h3>
          <p class="text-sm text-slate-600 mb-3">
            Jakarta Selatan adalah pusat fine dining & hospitality premium
            Indonesia. Kami sudah terbiasa melayani:
          </p>
          <ul class="space-y-2">
            {jakselIndustri.map((z) => (
              <li class="flex items-start gap-2.5 p-3 rounded-lg bg-slate-50 border border-slate-100">
                <span class="w-1.5 h-1.5 rounded-full bg-[#166534] mt-2 shrink-0"></span>
                <div>
                  <strong class="text-sm text-[#052c17]">{z.name}</strong>
                  <p class="text-xs text-slate-600 leading-snug mt-0.5">
                    {z.note}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-lg sm:text-xl font-bold text-[#052c17] mb-3 flex items-center gap-2">
            <Clock size={18} class="text-[#166534]" /> Timeline Distribusi Subuh
          </h3>
          <p class="text-sm text-slate-600 mb-3">
            Koki fine dining butuh sayur sebelum jam 6 untuk prep. Berikut
            jadwal operasional kami:
          </p>
          <div class="space-y-2">
            {city.logistics.map((l) => (
              <div class="flex items-start gap-3 p-3 rounded-lg bg-white border border-slate-200">
                <div class="shrink-0 text-center">
                  <span class="inline-block text-xs font-mono font-bold text-[#166534] bg-green-50 border border-green-200 rounded px-2 py-0.5">
                    {l.time}
                  </span>
                </div>
                <div>
                  <strong class="text-sm text-[#052c17]">{l.title}</strong>
                  <p class="text-xs text-slate-600 leading-snug mt-0.5">
                    {l.desc}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ SECTION 5: LEGALITAS ============ -->
      <section>
        <h3 class="text-lg sm:text-xl font-bold text-[#052c17] mb-3 flex items-center gap-2">
          <ShieldCheck size={18} class="text-[#166534]" /> Legalitas & Administrasi Perusahaan
        </h3>
        <div class="grid sm:grid-cols-2 gap-2.5">
          {jakselLegal.map((item) => (
            <div class="flex items-start gap-2.5 p-3 rounded-lg bg-green-50/60 border border-green-100">
              <CheckCircle2 size={14} class="text-[#166534] mt-0.5 shrink-0" />
              <span class="text-sm text-slate-700 leading-snug">{item}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ SECTION 6: ZONA KECAMATAN ============ -->
      <section>
        <div class="mb-3">
          <h3 class="text-lg sm:text-xl font-bold text-[#052c17] flex items-center gap-2">
            <MapPin size={18} class="text-[#166534]" /> Zona Pengiriman — Jakarta Selatan & Sekitarnya
          </h3>
          <p class="text-sm text-slate-600 mt-1">
            Jadwal dan minimum order disesuaikan dengan karakter tiap zona.
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
          {jakselZones.map((z) => (
            <div class="p-3 rounded-lg border border-slate-200 bg-white hover:border-[#166534] hover:bg-green-50/40 transition">
              <div class="font-bold text-xs text-[#052c17] mb-0.5">
                {z.name}
              </div>
              <div class="text-[11px] text-slate-600 leading-snug">
                {z.note}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ SECTION 7: AREA SEKITAR ============ -->
      <section>
        <div class="mb-3">
          <h3 class="text-lg sm:text-xl font-bold text-[#052c17] flex items-center gap-2">
            <Truck size={18} class="text-[#166534]" /> Area Sekitar {city.name}
          </h3>
          <p class="text-sm text-slate-600 mt-1">
            Kami juga melayani kota-kota berikut dengan pola pengiriman yang
            sama.
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
          {otherCities.map((otherCity) => (
            <a
              href={`/kota/${otherCity.slug}`}
              class="group p-3 rounded-lg border border-slate-200 bg-white hover:border-[#166534] hover:bg-green-50 transition text-center"
            >
              <span class="text-xs font-bold uppercase tracking-wide text-[#052c17] group-hover:text-[#166534]">
                {otherCity.name}
              </span>
            </a>
          ))}
        </div>
      </section>

      <!-- ============ SECTION 8: CONTACT FORM + TERMIN 7 HARI ============ -->
      <section id="kontak" class="scroll-mt-20">
        <div class="rounded-2xl border-2 border-[#166534] bg-gradient-to-br from-[#f0fdf4] to-white overflow-hidden">

          <!-- Header form -->
          <div class="p-5 sm:p-6 border-b-2 border-[#166534]/20 bg-[#166534]">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-white/15 backdrop-blur flex items-center justify-center shrink-0">
                <Send size={18} class="text-white" />
              </div>
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-white">
                  Minta Penawaran Suplai {city.name}
                </h3>
                <p class="text-xs sm:text-sm text-green-100 mt-0.5">
                  Isi form — tim kami balas via WhatsApp dalam 1×24 jam kerja.
                </p>
              </div>
            </div>

            <!-- Badge Termin 7 Hari -->
            <div class="mt-4 inline-flex items-center gap-2 bg-yellow-300 text-[#052c17] border border-yellow-400 rounded-lg px-3 py-1.5">
              <CalendarClock size={14} />
              <span class="text-xs font-bold">
                Termin Pembayaran 7 Hari untuk Klien Baru
              </span>
            </div>
          </div>

          <!-- Form body -->
          <form
            id="kontak-form"
            class="p-5 sm:p-6 space-y-4"
            data-wa={waNumber}
            data-kota={city.name}
            novalidate
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="nama" class="block text-xs font-bold text-[#052c17] mb-1">
                  Nama Lengkap <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="nama"
                  name="nama"
                  required
                  autocomplete="name"
                  placeholder="Budi Santoso"
                  class="w-full px-3 py-2.5 text-sm rounded-lg border border-slate-300 bg-white focus:border-[#166534] focus:ring-2 focus:ring-[#166534]/20 outline-none transition"
                />
              </div>

              <div>
                <label for="usaha" class="block text-xs font-bold text-[#052c17] mb-1">
                  Nama Usaha / Restoran <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="usaha"
                  name="usaha"
                  required
                  autocomplete="organization"
                  placeholder="Resto Fine Dining Senopati"
                  class="w-full px-3 py-2.5 text-sm rounded-lg border border-slate-300 bg-white focus:border-[#166534] focus:ring-2 focus:ring-[#166534]/20 outline-none transition"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="whatsapp" class="block text-xs font-bold text-[#052c17] mb-1">
                  No. WhatsApp <span class="text-rose-500">*</span>
                </label>
                <input
                  type="tel"
                  id="whatsapp"
                  name="whatsapp"
                  required
                  inputmode="numeric"
                  pattern="[0-9+\s-]{8,18}"
                  autocomplete="tel"
                  placeholder="08xx xxxx xxxx"
                  class="w-full px-3 py-2.5 text-sm rounded-lg border border-slate-300 bg-white focus:border-[#166534] focus:ring-2 focus:ring-[#166534]/20 outline-none transition"
                />
              </div>

              <div>
                <label for="zona" class="block text-xs font-bold text-[#052c17] mb-1">
                  Zona Pengiriman <span class="text-rose-500">*</span>
                </label>
                <select
                  id="zona"
                  name="zona"
                  required
                  class="w-full px-3 py-2.5 text-sm rounded-lg border border-slate-300 bg-white focus:border-[#166534] focus:ring-2 focus:ring-[#166534]/20 outline-none transition"
                >
                  <option value="">— Pilih zona —</option>
