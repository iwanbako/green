    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": baseUrl },
        { "@type": "ListItem", "position": 2, "name": "Area", "item": `${baseUrl}/area` },
        { "@type": "ListItem", "position": 3, "name": district.name, "item": currentUrl }
      ]
    }
  ]
};

// Related Areas Logic
const allDistricts = districtsData.districts;
const currentIndex = allDistricts.findIndex(d => d.slug === "alam-sutera");
const otherAreas = [];
for (let i = 1; i <= 6; i++) {
  const nextIndex = (currentIndex + i) % allDistricts.length;
  otherAreas.push(allDistricts[nextIndex]);
}
const labels = ["Logistik", "Distribusi", "Supply", "Pengiriman", "Area", "Layanan"];
---

<MainLayout title={title} description={description}>

  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} slot="head" />

  <div class="bg-[#0b130f] text-slate-100 font-sans antialiased overflow-x-hidden selection:bg-emerald-500 selection:text-emerald-950 text-left reveal-container">
    <Header />

    <main class="w-full">
      <!-- Breadcrumb Bar -->
      <div class="pt-24 lg:pt-32 bg-[#111c16] border-b border-emerald-900/40 shadow-sm">
        <nav aria-label="Breadcrumb" class="w-full max-w-7xl mx-auto px-6 py-4 flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em]">
          <a href="/" class="text-slate-400 hover:text-emerald-400 transition-colors">Beranda</a>
          <ChevronRight size={10} class="text-slate-600" />
          <a href="/area" class="text-slate-400 hover:text-emerald-400 transition-colors">Area</a>
          <ChevronRight size={10} class="text-slate-600" />
          <span class="text-emerald-400 font-bold tracking-widest uppercase">{district.name}</span>
        </nav>
      </div>

      <DistrictHero district={district} />

      <!-- Rating Bar -->
      <div class="w-full bg-gradient-to-r from-[#07100b] via-[#0f2316] to-[#07100b] text-white py-4 border-y border-emerald-900/60 shadow-sm">
