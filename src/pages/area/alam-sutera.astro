                  href={`/area/${area.slug}`}
                  class="group p-4 rounded-2xl bg-[#17281f] border border-emerald-800/60 hover:border-emerald-500 hover:bg-[#1e3427] transition-all flex flex-col items-center justify-center gap-1 shadow-sm text-center"
                >
                  <span class="text-[9px] font-black text-emerald-400 uppercase tracking-widest">
                    {labels[index % labels.length]}
                  </span>
                  <span class="text-xs font-black text-slate-200 group-hover:text-emerald-300 uppercase tracking-wider block transition-colors">
                    {area.name}
                  </span>
