          </div>
        </div>
      </section>

      <!-- Quality Guarantee Section -->
      <section class="w-full bg-[#0d1712] py-16 border-b border-emerald-900/40">
        <div class="w-full max-w-7xl mx-auto px-6">
          <div class="p-8 bg-[#121f18] rounded-3xl border border-emerald-800/40 shadow-xl">
