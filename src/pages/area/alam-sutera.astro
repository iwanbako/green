            <h3 class="text-xl font-black text-white mb-8 uppercase tracking-widest flex items-center gap-2">
              <MapPin size={20} class="text-emerald-400" /> Area Layanan Terkait
            </h3>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
