---
/**
 * CITY HERO - ASTRO VERSION
 * Redesign: Hierarchy jelas, tipografi konsisten, visual bersih.
 */
import { MapPin, ArrowRight, ShieldCheck, Truck, CheckCircle2 } from 'lucide-react';

const { city } = Astro.props;
const cityName = city?.name || 'Seluruh Wilayah';
const seoContent = city?.seoContent || null;

const heroImageUrl = "https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&q=80&w=1200";

const trustPoints = [
  'Panen pagi, kirim subuh',
  'Grade A tersortasi',
  'Legalitas PKP resmi',
];
---

<section class="relative overflow-hidden font-sans bg-[#052c17] text-white">
  <!-- Background decoration (subtle) -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-emerald-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-[#bef264]/5 rounded-full blur-3xl"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(21,128,61,0.15)_0%,transparent_60%)]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">

      <!-- LEFT: Content -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8">

        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/10 rounded-full backdrop-blur-sm">
          <MapPin size={13} class="text-[#bef264]" />
          <span class="text-[11px] font-bold text-[#bef264] uppercase tracking-wider">
            {cityName} Hub
          </span>
        </div>

        <!-- H1 -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold leading-[1.05] tracking-tight text-white">
          Supplier Sayur{' '}
          <span class="text-[#bef264]">{cityName}</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg lg:text-xl text-slate-300 leading-relaxed max-w-2xl">
          Distribusi sayuran segar hasil panen Cipanas untuk hotel, restoran,
          katering, dan food court di wilayah {cityName}. Pengiriman subuh
          dengan rantai dingin terjaga.
        </p>

        <!-- SEO Content quote (optional) -->
        {seoContent && (
          <div class="max-w-2xl border-l-2 border-[#bef264]/40 pl-4 sm:pl-5">
            <p class="text-sm sm:text-base text-slate-400 leading-relaxed italic">
              {seoContent}
            </p>
          </div>
        )}

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 pt-2">
          <a
            href="#katalog"
            class="group inline-flex items-center justify-center gap-2 bg-[#bef264] hover:bg-[#a8e04a] text-[#052c17] px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl text-sm font-bold uppercase tracking-wide transition-all shadow-lg shadow-[#bef264]/20 active:scale-95"
          >
            Cek Katalog Produk
            <ArrowRight size={18} class="group-hover:translate-x-1 transition-transform" />
          </a>
          <a
            href="#kemitraan"
            class="inline-flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 text-white px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl text-sm font-bold uppercase tracking-wide border border-white/15 hover:border-white/30 transition-all active:scale-95"
          >
            Hubungi Sales
          </a>
        </div>

        <!-- Trust Points -->
        <div class="flex flex-wrap gap-x-6 gap-y-2 pt-4">
          {trustPoints.map((point) => (
            <div class="flex items-center gap-2">
              <CheckCircle2 size={16} class="text-[#bef264] shrink-0" />
              <span class="text-xs sm:text-sm text-slate-300 font-medium">
                {point}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- RIGHT: Image -->
      <div class="lg:col-span-5 relative">
        <div class="relative aspect-[4/5] sm:aspect-[3/4] lg:aspect-[4/5] max-w-md mx-auto lg:max-w-none rounded-2xl overflow-hidden shadow-2xl shadow-black/40 border border-white/10">
          <img
            src={heroImageUrl}
            alt={`Supplier Sayur Segar Green Fresh Cipanas di ${cityName}`}
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <!-- Gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#052c17] via-[#052c17]/30 to-transparent"></div>

          <!-- Bottom card -->
          <div class="absolute bottom-4 left-4 right-4 sm:bottom-6 sm:left-6 sm:right-6">
            <div class="bg-white/10 backdrop-blur-lg border border-white/20 rounded-xl p-3 sm:p-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-lg bg-[#bef264] flex items-center justify-center shrink-0">
                  <ShieldCheck size={20} class="text-[#052c17]" />
                </div>
                <div class="min-w-0">
                  <p class="text-[10px] font-bold text-[#bef264] uppercase tracking-wider leading-none mb-1">
                    Quality Verified
                  </p>
                  <p class="text-sm sm:text-base font-bold text-white leading-tight">
                    Standar Operasional Horeka
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Top badge -->
          <div class="absolute top-4 left-4 sm:top-6 sm:left-6">
            <span class="inline-flex items-center gap-1.5 bg-[#052c17]/80 backdrop-blur-md border border-white/20 px-3 py-1.5 rounded-full text-[10px] font-bold uppercase tracking-wider text-white">
              <Truck size={12} class="text-[#bef264]" />
              Fresh Daily
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>