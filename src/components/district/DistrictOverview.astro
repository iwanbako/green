---
/**
 * DISTRICT OVERVIEW - ASTRO VERSION (SEO Optimized & Dark Mode)
 * Strategi: Zero Hydration untuk Kejelasan Data Operasional bagi Googlebot.
 */
import { 
  MapPin, Package, Clock, Users, 
  Target, TrendingUp, Shield,
  Truck, CheckCircle2
} from 'lucide-react';

const { district } = Astro.props;

// Pengamanan data di sisi server (Build Time)
const logisticsTime = district?.logistics?.time?.split(',')[0] || '--:--';
const clientFocusPrimary = district?.clientFocus?.split(', ')[0] || 'General B2B';

const overviewItems = [
  {
    icon: MapPin,
    title: "ZONA DISTRIBUSI",
    value: district?.name || "Wilayah Kerja",
    desc: "Area cakupan pengiriman prioritas harian",
    metric: "Priority Zone",
  },
  {
    icon: Package,
    title: "SUMBER UTAMA",
    value: district?.origin || "Cipanas, Jabar",
    desc: "Pasokan langsung dari sentra produksi",
    metric: "Direct Supply",
  },
  {
    icon: Clock,
    title: "JADWAL LOGISTIK",
    value: logisticsTime,
    desc: "Keberangkatan batch reguler terjadwal",
    metric: "On-Time Run",
  },
  {
    icon: Users,
    title: "FOKUS KLIEN",
    value: clientFocusPrimary,
    desc: "Standar pemenuhan komoditas bisnis",
    metric: "B2B Standard",
  }
];

const performanceMetrics = [
  {
    icon: Target,
    label: "SLA Compliance",
    value: "99.2%",
    trend: "+1.5%"
  },
  {
    icon: Truck,
    label: "Fleet Status",
    value: "Dedicated",
    trend: "Optimal"
  },
  {
    icon: TrendingUp,
    label: "Avg. Lead Time",
    value: district?.leadTime || "<18h",
    trend: "Fast"
  },
  {
    icon: Shield,
    label: "Handling Score",
    value: "Tier A",
    trend: "Verified"
  }
];
---

<div class="w-full space-y-8 text-left font-sans reveal-container">
  <!-- Header Section -->
  <div class="space-y-4">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-emerald-950/80 rounded-full border border-emerald-800/60 reveal-left">
      <div class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></div>
      <span class="text-[10px] font-black uppercase tracking-[0.3em] text-emerald-400">
        DISTRICT OVERVIEW
      </span>
    </div>
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 text-left">
      <div class="text-left max-w-3xl">
        <h2 class="text-3xl md:text-5xl font-black text-white leading-tight reveal-up tracking-tight uppercase">
          Operational <span class="text-emerald-400">Strategic Hub.</span>
        </h2>
        <p class="text-sm md:text-base text-slate-300 font-medium mt-3 leading-relaxed text-left reveal-up" style="transition-delay: 0.1s;">
          Manajemen rantai pasok terintegrasi untuk wilayah <span class="font-bold text-emerald-300">{district?.name || 'terkait'}</span> dengan jaminan keamanan muatan dan ketepatan waktu pengiriman harian.
        </p>
      </div>
      
      <div class="flex-shrink-0 reveal-scale" style="transition-delay: 0.2s;">
        <div class="px-5 py-3 bg-[#07130c] rounded-2xl text-white shadow-md border border-emerald-800/60">
          <div class="text-[9px] font-bold uppercase tracking-[0.2em] text-slate-400 mb-1 text-center">Operational Grade</div>
          <div class="flex items-center gap-2 justify-center">
            <CheckCircle2 size={16} class="text-emerald-400" />
            <span class="text-lg font-black italic tracking-tighter text-white">ENTERPRISE</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Performance Metrics Bar (4 Columns) -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    {performanceMetrics.map((metric, index) => (
      <div 
        class="p-4 bg-[#17281f] rounded-2xl border border-emerald-800/50 hover:bg-[#1e3427] hover:border-emerald-500/60 transition-all duration-300 group reveal-up"
        style={`transition-delay: ${0.3 + (index * 0.05)}s;`}
      >
        <div class="flex items-center gap-2 mb-2">
          <div class="p-1.5 bg-[#0e1913] rounded-lg border border-emerald-900/60 group-hover:border-emerald-700/60 transition-colors">
            <div class="text-emerald-400"><metric.icon size={14} /></div>
          </div>
          <span class="text-[10px] font-black uppercase tracking-wider text-slate-400">
            {metric.label}
          </span>
        </div>
        <div class="flex items-baseline justify-between">
          <div class="text-2xl font-black text-white">
            {metric.value}
          </div>
          <div class="text-[9px] font-bold px-2 py-0.5 rounded-md bg-emerald-950 text-emerald-300 border border-emerald-800/80">
            {metric.trend}
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Overview Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    {overviewItems.map((item, index) => (
      <div 
        class="p-6 rounded-3xl border border-emerald-800/50 bg-[#17281f] hover:border-emerald-500/80 hover:bg-[#1e3427] hover:shadow-lg hover:shadow-emerald-950/40 transition-all duration-300 reveal-up flex flex-col justify-between"
        style={`transition-delay: ${0.4 + (index * 0.1)}s;`}
      >
        <div class="text-left space-y-4">
          <div class="flex items-center justify-between">
            <div class="p-2.5 rounded-xl bg-[#0e1913] text-emerald-400 border border-emerald-900/80">
              <item.icon class="w-5 h-5" />
            </div>
            <span class="text-[9px] font-black px-2.5 py-1 rounded-full bg-emerald-950 border border-emerald-800/80 text-emerald-300 uppercase tracking-widest">
              {item.metric}
            </span>
          </div>

          <div>
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 block mb-1">
              {item.title}
            </span>
            <h4 class="text-xl font-black text-white tracking-tight leading-snug">
              {item.value}
            </h4>
          </div>
        </div>
        
        <p class="text-xs text-slate-300 font-medium leading-relaxed mt-4 pt-4 border-t border-emerald-900/60 text-left">
          {item.desc}
        </p>
      </div>
    ))}
  </div>

  <!-- Commitment Banner -->
  <div class="bg-gradient-to-r from-[#0a1810] via-[#0f281a] to-[#0a1810] rounded-3xl border border-emerald-800/60 text-white shadow-xl overflow-hidden reveal-up" style="transition-delay: 0.6s;">
    <div class="p-6 md:p-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2 flex-1 text-left">
          <div class="flex items-center gap-2">
            <Shield size={16} class="text-emerald-400" />
            <h4 class="text-[10px] font-black text-emerald-300 uppercase tracking-[0.3em]">
              Supply Chain Commitment
            </h4>
          </div>
          <p class="text-sm md:text-base font-semibold text-slate-200 leading-snug text-left">
            Komitmen pengiriman tepat waktu dengan protokol sortasi ketat untuk memastikan standar kualitas terbaik sampai di lokasi Anda.
          </p>
        </div>
        
        <div class="flex-shrink-0">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-[#06100a] rounded-xl border border-emerald-700/40">
            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
            <span class="text-xs font-black text-emerald-300 uppercase tracking-wider leading-none">Status: Active</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .reveal-container .reveal-up,
  .reveal-container .reveal-left,
  .reveal-container .reveal-scale {
    opacity: 0;
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-up { transform: translateY(20px); }
  .reveal-left { transform: translateX(-20px); }
  .reveal-scale { transform: scale(0.98); }

  :global(.is-visible) .reveal-up,
  :global(.is-visible) .reveal-left {
    opacity: 1;
    transform: translate(0);
  }
  :global(.is-visible) .reveal-scale {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  const setupOverviewObserver = () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-container, .reveal-up, .reveal-scale').forEach(el => observer.observe(el));
  };

  setupOverviewObserver();
  document.addEventListener('astro:after-swap', setupOverviewObserver);
</script>