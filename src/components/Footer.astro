---
/**
 * FOOTER COMPONENT - 2 COLUMN MOBILE & FLOATING STICKY BOTTOM
 */
import { Leaf, Phone, Send, Mail, MapPin, ShoppingBag, MessageCircle } from 'lucide-react';

const currentYear = new Date().getFullYear();
const waNumber = "6287780937884";
const waText = "Halo Green Fresh, saya ingin melakukan pemesanan sayuran. Mohon informasi stok harian. Terima kasih.";
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(waText)}`;
---

<footer class="bg-[#052c17] text-white pt-12 md:pt-20 font-sans border-t border-white/5 pb-24 md:pb-0 relative">
  <div class="max-w-[1400px] mx-auto px-6">
    
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-y-10 gap-x-6 mb-12 md:mb-16">
      
      <div class="col-span-2 lg:col-span-1 space-y-4 md:space-y-6">
        <a href="/" class="flex items-center gap-2 group">
          <Leaf class="text-[#bef264] w-5 h-5 md:w-6 md:h-6" fill="currentColor" />
          <span class="text-lg md:text-xl font-black uppercase tracking-tighter">
            Green<span class="text-[#bef264]">Fresh</span>
          </span>
        </a>
        <p class="text-[11px] md:text-sm text-slate-400 font-medium leading-relaxed max-w-[280px]">
          Penyedia sayuran grade A untuk kebutuhan industri horeka dan ritel modern.
        </p>
      </div>

      <div class="space-y-4 md:space-y-6">
        <h4 class="text-[9px] md:text-[10px] font-black uppercase tracking-[0.3em] text-[#bef264]">Navigasi</h4>
        <ul class="space-y-2 md:space-y-3 text-[11px] md:text-sm font-bold text-slate-300">
          <li><a href="/produk" class="hover:text-white transition-colors">Produk</a></li>
          <li><a href="/gallery" class="hover:text-white transition-colors">Gallery</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">Tentang</a></li>
        </ul>
      </div>

      <div class="space-y-4 md:space-y-6">
        <h4 class="text-[9px] md:text-[10px] font-black uppercase tracking-[0.3em] text-[#bef264]">Wilayah</h4>
        <ul class="space-y-2 md:space-y-3 text-[11px] md:text-sm font-bold text-slate-300">
          <li><a href="/kota" class="hover:text-white transition-colors">Index Kota</a></li>
          <li><a href="/area" class="hover:text-white transition-colors">Index Area</a></li>
        </ul>
      </div>

      <div class="col-span-2 lg:col-span-1 space-y-4 md:space-y-6 text-left">
        <h4 class="text-[9px] md:text-[10px] font-black uppercase tracking-[0.3em] text-[#bef264]">Hubungi Kami</h4>
        <div class="space-y-3 md:space-y-4 text-[11px] md:text-sm font-bold">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-white hover:text-[#bef264] transition-colors">
            <Phone size={14} class="text-[#bef264]" /> 0877 8093 7884
          </a>
          <a href="mailto:sales@greenfresh.co.id" class="flex items-center gap-3 text-white hover:text-[#bef264] transition-colors break-all">
            <Mail size={14} class="text-[#bef264]" /> sales@greenfresh.co.id
          </a>
          <div class="flex items-center gap-3 text-slate-400">
            <MapPin size={14} /> Cipanas, Jawa Barat
          </div>
        </div>
      </div>
    </div>

    <div class="py-6 md:py-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
      <p class="text-[9px] md:text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">
        CV Green Fresh Cipanas © {currentYear}
      </p>
      
      <a href="https://t.me/suppliersayur_bot" target="_blank" rel="noopener noreferrer" class="text-[9px] md:text-[10px] font-black uppercase tracking-widest text-[#bef264] flex items-center gap-2 bg-white/5 px-4 py-2 rounded-full border border-white/10">
        <Send size={12} /> Telegram Price Bot
      </a>
    </div>
  </div>

  <div class="h-1 w-full bg-[#bef264] opacity-10"></div>

  <!-- FLOATING STICKY BOTTOM BAR (Khusus Mobile / Layar HP) -->
  <div class="md:hidden fixed bottom-3 left-3 right-3 z-[110] bg-[#07190f]/95 backdrop-blur-md border border-emerald-800/60 p-2.5 rounded-2xl shadow-2xl flex items-center gap-2">
    <a 
      href="/produk" 
      class="flex-1 flex items-center justify-center gap-2 py-3 px-4 bg-[#122419] text-slate-200 hover:text-white rounded-xl text-[10px] font-black uppercase tracking-widest border border-emerald-800/50 transition-all shadow-sm"
    >
      <ShoppingBag size={14} class="text-emerald-400" />
      Katalog Produk
    </a>
    <a 
      href={waLink} 
      target="_blank" 
      rel="noopener noreferrer"
      class="flex-1 flex items-center justify-center gap-2 py-3 px-4 bg-emerald-600 hover:bg-emerald-500 text-[#052c17] rounded-xl text-[10px] font-black uppercase tracking-widest shadow-md transition-all font-bold"
    >
      <MessageCircle size={14} fill="currentColor" />
      WhatsApp Sales
    </a>
  </div>
</footer>